[Unit]
Description=Natsai Arc Consensus Observatory
After=network-online.target arc-mainnet-execution.service arc-mainnet-consensus.service
Wants=network-online.target
Requires=arc-mainnet-execution.service arc-mainnet-consensus.service

[Service]
Type=simple
User=natsai-observatory
Group=natsai-observatory

ExecStart=/usr/bin/python3 /opt/natsai-arc-observatory/collector.py

Restart=always
RestartSec=5

Environment=PYTHONUNBUFFERED=1

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

ReadWritePaths=/var/lib/natsai-arc-observatory

MemoryMax=256M
CPUQuota=25%

[Install]
WantedBy=multi-user.target
